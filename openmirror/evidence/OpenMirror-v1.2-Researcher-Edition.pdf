"""Read-only verification of records extracted from the OpenMirror v1.2 PDF.

Requires Python 3 standard library only. Save ALL PDF attachments into one folder,
then run: python verify-records.py
This checks stored bytes and arithmetic. It does not call a model, establish the
correctness of a review judgment, or test the proposed grounding mechanism.
"""
from collections import Counter, defaultdict
from pathlib import Path
import hashlib
import json

folder = Path(__file__).resolve().parent
def read(name):
    return json.loads((folder/name).read_text(encoding='utf-8'))

manifest = read('publication-records-manifest.json')
for item in manifest['files']:
    name=item['name']
    assert Path(name).name == name, 'Unexpected non-flat record path'
    data=(folder/name).read_bytes()
    assert len(data) == item['bytes'], f'Byte count mismatch: {name}'
    assert hashlib.sha256(data).hexdigest() == item['sha256'], f'Hash mismatch: {name}'

initial=read('adversarial-review.json')
addendum=read('adversarial-review-adjudication.json')
key={r['anonymous_id']:r for r in read('response-model-key.json')}
rows={(r['response'],r['case']):dict(r['criteria']) for r in initial['rows']}
assert len(rows)==48
for revision in addendum['adjudications']:
    row=(revision['response'],revision['case'])
    assert row in rows
    rows[row]=dict(revision['revised_criteria'])
totals=Counter(); by_model=defaultdict(Counter)
for (response,case),criteria in rows.items():
    values=set(criteria.values())
    assert values <= {'met','not_met','cannot_decide'}
    result='not_met' if 'not_met' in values else 'cannot_decide' if 'cannot_decide' in values else 'met'
    totals[result]+=1
    by_model[key[response]['reported_model']][result]+=1
for record in key.values():
    data=(folder/(record['response_id']+'.md')).read_bytes()
    assert hashlib.sha256(data).hexdigest()==record['raw_sha256']
summary=read('evaluation-summary.json')
assert dict(totals)==summary['final_case_results']
assert {k:dict(v) for k,v in by_model.items()}==summary['by_model']
print(json.dumps({'record_hashes_match':len(manifest['files']), 'case_rows':len(rows),
                  'counts_match':True,'final_case_results':dict(totals),
                  'limit':'Stored records and calculation only; no inference or mechanism test.'}, indent=2))

endstream
endobj
